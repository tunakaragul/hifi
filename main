  rec.c1 = rec.homePos.clone().add(new THREE.Vector3(0,8,0));
  rec.c2 = P3.clone().add(new THREE.Vector3(0,6,-8));
  rec.qFlat = new THREE.Quaternion();

  disc.position.copy(rec.homePos);
  disc.quaternion.copy(rec.qShelf);
  disc.scale.setScalar(DISC_SCALE);
  disc.visible = false;
  scene.add(disc);
});

/* yükleme durumu */
let loaded = null, anim = null;
const jobs = [];
const DUR_PATH = 1.9, DUR_DROP = 0.5;
const qTmp = new THREE.Quaternion();

function busy() { return !!anim || jobs.length > 0; }

function mountOnPlatter(rec) {
  platGroup.add(rec.disc);
  rec.disc.visible = true;
  rec.disc.position.set(0,2.0,0);
  rec.disc.quaternion.identity();
  rec.disc.scale.setScalar(1);
  rec.out = true;
  loaded = rec;
}
mountOnPlatter(RECORDS[0]);          // başlangıçta 1. plak platterda

function requestRecord(rec) {
  if (busy()) return;
  if (loaded === rec) { jobs.push({ type:'eject' }); return; }
  if (loaded) jobs.push({ type:'eject' });
  jobs.push({ type:'load', rec });
}
function requestEject() { if (!busy() && loaded) jobs.push({ type:'eject' }); }

function placeOnPath(rec, u) {
  const mt = 1-u, d = rec.disc;
  d.position.set(0,0,0)
    .addScaledVector(rec.homePos, mt*mt*mt)
    .addScaledVector(rec.c1, 3*mt*mt*u)
    .addScaledVector(rec.c2, 3*mt*u*u)
    .addScaledVector(P3, u*u*u);
  qTmp.copy(rec.qShelf).slerp(rec.qFlat, ease((u-0.25)/0.6));
  d.quaternion.copy(qTmp);
  d.scale.setScalar(DISC_SCALE + (1-DISC_SCALE)*ease(u/0.8));
}

function startJob(job) {
  if (job.type === 'eject') {
    const rec = loaded;
    scene.attach(rec.disc);                         // dünya konumunu koruyarak sahneye al
    rec.qFlat.copy(rec.disc.quaternion);
    loaded = null;
    anim = { rec, type:'out', phase:0, t:0, fromY:rec.disc.position.y };
  } else {
    const rec = job.rec;
    rec.disc.visible = true;
    rec.out = true;
    rec.qFlat.identity();
    placeOnPath(rec, 0);
    anim = { rec, type:'in', phase:0, t:0 };
  }
  refreshHUD();
}

function updateJobs(dt) {
  if (!anim && jobs.length) {
    armTarget = ARM_REST;                           // önce kol dinlenmeye dönsün
    if (!armDragging && armAngle > ARM_REST-0.03 && armLift > 0.25) startJob(jobs.shift());
  }
  if (!anim) return;
  const A = anim, d = A.rec.disc;
  A.t += dt;
  if (A.type === 'in') {
    if (A.phase === 0) {
      placeOnPath(A.rec, ease(A.t/DUR_PATH));
      if (A.t >= DUR_PATH) { A.phase = 1; A.t = 0; }
    } else {
      const k = ease(A.t/DUR_DROP);
      d.position.set(PLAT_X, P3.y + (PLAT_SURFACE_Y-P3.y)*k, 0);
      d.quaternion.identity(); d.scale.setScalar(1);
      if (A.t >= DUR_DROP) { mountOnPlatter(A.rec); anim = null; refreshHUD(); }
    }
  } else {
    if (A.phase === 0) {
      const k = ease(A.t/DUR_DROP);
      d.position.y = A.fromY + (P3.y-A.fromY)*k;
      if (A.t >= DUR_DROP) { A.phase = 1; A.t = 0; }
    } else {
      placeOnPath(A.rec, 1 - ease(A.t/DUR_PATH));
      if (A.t >= DUR_PATH) { d.visible = false; A.rec.out = false; anim = null; refreshHUD(); }
    }
  }
}

