/* iğne ucunun yarıçapı ve "cue" açısı */
function stylusRadius() {
  const v = stylusTip.getWorldPosition(new THREE.Vector3());
  return Math.hypot(v.x - PLAT_X, v.z);
}
let CUE_ANGLE = 2.3;
{
  let best = 1e9; const save = pivG.rotation.y;
  for (let a = ARM_MIN; a <= ARM_REST; a += 0.005) {
    pivG.rotation.y = a; pivG.updateMatrixWorld(true);
    const d = Math.abs(stylusRadius() - 5.4);
    if (d < best) { best = d; CUE_ANGLE = a; }
  }
  pivG.rotation.y = save; pivG.updateMatrixWorld(true);
}

